---
const profile = {
  name: "Alfan Aziz",
  role: "Digital Creator",
  headline: "Clean thinking. Sharp execution.",
  intro:
    "I build digital work that feels clear, contemporary, and easy to trust. My focus sits at the intersection of design, front-end craft, and product storytelling.",
  socials: [
    { label: "LinkedIn", href: "https://www.linkedin.com/in/alfan-azizi" },
    { label: "Instagram", href: "https://www.instagram.com/alfanzizi" },
    { label: "GitHub", href: "https://github.com/alfanazizi" },
  ],
  strengths: ["Design systems", "Front-end", "Product thinking", "Creative coding"],
  projects: [
    {
      name: "alfanazizi.github.io",
      description: "Personal portfolio and digital presence built with Astro and GitHub Pages.",
      tags: ["Astro", "Portfolio", "GitHub Pages"],
      href: "https://github.com/alfanazizi/alfanazizi.github.io",
    },
    {
      name: "alfanazizi",
      description: "GitHub profile and digital identity hub for quick access to my work.",
      tags: ["Profile", "Identity", "Config"],
      href: "https://github.com/alfanazizi/alfanazizi",
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Alfan Aziz is a digital creator focused on design, front-end craft, and thoughtful product experiences."
    />
    <title>{profile.name} | {profile.role}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div class="brand-wrap">
          <div class="brand-mark">A</div>
        </div>

        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#work">Work</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <div class="hero-copy">
            <p class="eyebrow">Digital creator / builder / storyteller</p>
            <h1>{profile.headline}</h1>
            <p class="intro">
              {profile.intro}
            </p>

            <div class="cta-row">
              {profile.socials.map((item) => (
                <a class="button" href={item.href} target="_blank" rel="noreferrer noopener">
                  {item.label}
                </a>
              ))}
            </div>

            <ul class="chip-list" aria-label="Core strengths">
              {profile.strengths.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="hero-card">
            <div class="card-frame">
              <div class="small-tag">PROFILE</div>
              <div class="card-name">{profile.name}</div>
              <div class="card-role">{profile.role}</div>
            </div>
          </div>
        </section>

        <section id="about" class="section-block">
          <p class="section-label">About</p>
          <div class="about-grid">
            <p>
              I build digital work that feels clear, contemporary, and easy to trust.
              My focus sits at the intersection of design, front-end development, and
              product storytelling.
            </p>
            <p>
              I enjoy turning messy ideas into polished experiences — whether that means a
              personal portfolio, a lightweight landing page, or a visual identity that
              feels memorable.
            </p>
          </div>
        </section>

        <section id="work" class="section-block">
          <p class="section-label">Repositories</p>
          <h2>Selected work</h2>

          <div class="project-list">
            {profile.projects.map((project) => (
              <article class="project-card">
                <div class="project-header">
                  <span class="dot"></span>
                  <span>{project.name}</span>
                </div>

                <p>{project.description}</p>

                <ul class="tag-list">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>

                <a class="repo-link" href={project.href} target="_blank" rel="noreferrer noopener">
                  View repository →
                </a>
              </article>
            ))}
          </div>
        </section>
      </main>

      <footer id="contact" class="site-footer">
        <p>Available for projects, collaborations, and creative conversations.</p>

        <div class="footer-links">
          <a href="https://www.linkedin.com/in/alfan-azizi" target="_blank" rel="noreferrer noopener">
            LinkedIn
          </a>
          <a href="https://www.instagram.com/alfanzizi" target="_blank" rel="noreferrer noopener">
            Instagram
          </a>
          <a href="https://github.com/alfanazizi" target="_blank" rel="noreferrer noopener">
            GitHub
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>