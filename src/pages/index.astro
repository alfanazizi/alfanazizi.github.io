---
import "../styles/global.css";

const siteUrl = "https://alfanazizi.github.io";
const photoBase = "https://images.unsplash.com";
const photos = [
  {
    src: `${photoBase}/photo-1519608487953-e999c86e7455`,
    alt: "A lone figure crossing a city street at dusk",
    title: "After the rain",
    place: "City streets · 01",
    className: "photo-tall",
  },
  {
    src: `${photoBase}/photo-1519501025264-65ba15a82390`,
    alt: "City buildings rising above a busy urban street",
    title: "Lines of the city",
    place: "Urban study · 02",
    className: "",
  },
  {
    src: `${photoBase}/photo-1518837695005-2083093ee35b`,
    alt: "Soft evening light falling across the water",
    title: "Quiet current",
    place: "Small moments · 03",
    className: "",
  },
  {
    src: `${photoBase}/photo-1519608487953-e999c86e7455`,
    alt: "Warm evening light on a city walk",
    title: "Last light",
    place: "Street notes · 04",
    className: "photo-wide",
  },
];

const projects = [
  {
    number: "01",
    category: "Digital presence",
    name: "This personal website",
    description:
      "A home for the work, ideas, photographs, and experiments I want to share with the world.",
    tags: ["Astro", "Design", "GitHub Pages"],
    href: "https://github.com/alfanazizi/alfanazizi.github.io",
    link: "Explore the repository",
  },
  {
    number: "02",
    category: "Open source",
    name: "Experiments in progress",
    description:
      "A growing collection of tools, AI explorations, and practical automation projects.",
    tags: ["AI", "Automation", "Microsoft"],
    href: "https://github.com/alfanazizi?tab=repositories",
    link: "Explore my GitHub",
  },
];

const socialLinks = [
  {
    label: "Instagram",
    detail: "Street frames & everyday moments",
    href: "https://www.instagram.com/alfanzizi",
    icon: "ig",
  },
  {
    label: "LinkedIn",
    detail: "Technology, work & ideas",
    href: "https://www.linkedin.com/in/alfan-azizi",
    icon: "in",
  },
  {
    label: "GitHub",
    detail: "Projects & experiments",
    href: "https://github.com/alfanazizi",
    icon: "gh",
  },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alfan Azizi",
  url: siteUrl,
  jobTitle: "Technology Professional and AI Builder",
  description:
    "Technology professional, AI builder, and street photographer documenting people, cities, creativity, and digital transformation.",
  sameAs: socialLinks.map(({ href }) => href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11110f" />
    <meta
      name="description"
      content="Alfan Azizi is a technology professional, AI builder, and street photographer exploring creativity, digital transformation, and the stories of everyday life."
    />
    <meta name="author" content="Alfan Azizi" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alfan Azizi" />
    <meta property="og:title" content="Alfan Azizi — Technology, AI & Street Photography" />
    <meta
      property="og:description"
      content="Capturing stories through technology and photography."
    />
    <meta property="og:url" content={siteUrl} />
    <meta
      property="og:image"
      content={`${photoBase}/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=1200&q=80`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Alfan Azizi — Technology, AI & Street Photography</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#home" aria-label="Alfan Azizi, home">
        <span class="wordmark-icon">A<span>.</span></span>
        <span class="wordmark-name">Alfan Azizi</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span></span><span></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#photography">Photography</a>
        <a href="#projects">Projects</a>
        <a href="#journal">Journal</a>
        <a class="nav-contact" href="#contact">Let’s connect <span>↗</span></a>
      </nav>
    </header>

    <main>
      <section class="hero section-wrap" id="home">
        <div class="hero-content">
          <p class="eyebrow"><span class="status-dot"></span> Technology · AI · Photography</p>
          <h1>Capturing stories through <span>technology</span> and photography.</h1>
          <p class="hero-subtitle">
            I explore the intersection of creativity, technology, artificial intelligence,
            and street photography.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#photography">Explore my work <span>↗</span></a>
            <a class="text-link" href="#about">A little about me <span>↓</span></a>
          </div>
          <div class="hero-footnote">
            <span class="scroll-line"></span>
            <span>Curious by nature. Creating with intention.</span>
          </div>
        </div>
        <div class="hero-visual">
          <img
            src={`${photoBase}/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=1200&q=82`}
            alt="A quiet city street glowing in the last light of day"
            fetchpriority="high"
            width="1200"
            height="1500"
          />
          <div class="image-shade"></div>
          <div class="image-location"><span>◉</span> Somewhere in the city, after hours</div>
          <div class="image-index">01 <span>/</span> 04</div>
          <div class="image-caption">
            <span>THROUGH MY LENS</span>
            <p>Everyday life, a little differently.</p>
          </div>
          <div class="hero-stamp" aria-hidden="true">STAY<br />CURIOUS<span>✳</span></div>
        </div>
        <div class="hero-bottom">
          <span>BASED IN INDONESIA · OPEN TO THE WORLD</span>
          <span>SCROLL TO EXPLORE <span class="down-arrow">↓</span></span>
        </div>
      </section>

      <section class="intro-section section-wrap" id="about">
        <div class="section-kicker"><span>01</span> THE PERSON BEHIND THE PIXELS</div>
        <div class="intro-grid">
          <h2>Building, learning,<br />and <em>documenting</em><br />the journey.</h2>
          <div class="intro-copy">
            <p>
              I’m Alfan — a technology professional and AI builder with a camera in my
              bag and a curious eye on the world. I’m interested in how thoughtful
              technology can make everyday work and life a little better.
            </p>
            <p>
              Away from the screen, I wander city streets looking for the fleeting
              gestures, textures, and human stories that make a place feel alive. This
              site is where those two worlds meet.
            </p>
            <a class="text-link" href="#contact">Get to know me <span>↗</span></a>
          </div>
        </div>
        <div class="journey-heading">
          <span class="principle-number">A PATH SHAPED BY CURIOSITY</span>
          <span>Different disciplines, one ongoing journey.</span>
        </div>
        <div class="journey-grid">
          <article>
            <span>01 — TECHNOLOGY</span>
            <h3>Make complexity feel simple.</h3>
            <p>
              My career in technology is driven by making systems, tools, and
              transformations useful for the people who rely on them.
            </p>
          </article>
          <article>
            <span>02 — AI & AUTOMATION</span>
            <h3>Build for what’s next.</h3>
            <p>
              I keep learning how AI and automation can create practical, human-centered
              ways to do better work.
            </p>
          </article>
          <article>
            <span>03 — PHOTOGRAPHY</span>
            <h3>Find the story in the ordinary.</h3>
            <p>
              Photography started as a reason to slow down and pay attention. The street
              keeps teaching me to look again.
            </p>
          </article>
        </div>
        <div class="principles">
          <article>
            <span class="principle-number">01 / BUILD</span>
            <h3>Make it useful.</h3>
            <p>Technology should solve real problems and leave room for people.</p>
          </article>
          <article>
            <span class="principle-number">02 / NOTICE</span>
            <h3>Stay curious.</h3>
            <p>There is always another perspective, on the street and on the screen.</p>
          </article>
          <article>
            <span class="principle-number">03 / SHARE</span>
            <h3>Bring others along.</h3>
            <p>Document what you learn. Good ideas get better when they are shared.</p>
          </article>
        </div>
        <div class="skills">
          <span class="principle-number">A FEW THINGS I BRING TOGETHER</span>
          <ul class="skill-list" aria-label="Skills and interests">
            <li>AI & automation</li>
            <li>Microsoft ecosystem</li>
            <li>Digital transformation</li>
            <li>Systems thinking</li>
            <li>Street photography</li>
            <li>Visual storytelling</li>
          </ul>
        </div>
      </section>

      <section class="photo-section" id="photography">
        <div class="section-wrap">
          <div class="section-heading">
            <div>
              <div class="section-kicker"><span>02</span> NOTES FROM THE STREETS</div>
              <h2>Looking closer.<br /><em>Feeling more.</em></h2>
            </div>
            <p>
              A work in progress, one frame and one walk at a time. People, places, and
              the little moments in between.
            </p>
          </div>
          <div class="photo-grid">
            {photos.map((photo, index) => (
              <button
                class:list={["photo-card", photo.className]}
                type="button"
                data-lightbox
                data-src={`${photo.src}?auto=format&fit=crop&w=1800&q=88`}
                data-alt={photo.alt}
                aria-label={`View photograph: ${photo.title}`}
              >
                <img
                  src={`${photo.src}?auto=format&fit=crop&w=900&q=78`}
                  alt={photo.alt}
                  loading="lazy"
                  width="900"
                  height="1100"
                />
                <span class="photo-number">0{index + 1}</span>
                <span class="photo-info">
                  <span>{photo.place}</span>
                  <strong>{photo.title}</strong>
                </span>
                <span class="photo-open" aria-hidden="true">↗</span>
              </button>
            ))}
          </div>
          <div class="photo-note">
            <span>STREET PHOTOGRAPHY · URBAN EXPLORATION · VISUAL STORYTELLING</span>
            <span>MORE FRAMES, SOON <span class="accent">✳</span></span>
          </div>
        </div>
      </section>

      <dialog class="lightbox" aria-label="Photograph viewer">
        <button class="lightbox-close" type="button" aria-label="Close photograph">×</button>
        <img src="" alt="" />
      </dialog>

      <section class="work-section section-wrap" id="projects">
        <div class="section-heading">
          <div>
            <div class="section-kicker"><span>03</span> THINGS I’M MAKING</div>
            <h2>Curiosity, <em>made tangible.</em></h2>
          </div>
          <p>
            From AI and automation to tools for the Microsoft ecosystem, I like turning
            ideas into things you can actually use.
          </p>
        </div>
        <div class="project-list">
          {projects.map((project) => (
            <article class="project-row">
              <span class="project-number">{project.number}</span>
              <div class="project-main">
                <span class="project-category">{project.category}</span>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <ul class="tag-list">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <a class="project-link" href={project.href} target="_blank" rel="noreferrer">
                {project.link} <span>↗</span>
              </a>
            </article>
          ))}
        </div>
        <div class="project-outro">
          <span>GOOD WORK TAKES CURIOSITY, ITERATION, AND A LITTLE COURAGE.</span>
          <a class="text-link" href="https://github.com/alfanazizi" target="_blank" rel="noreferrer">
            More on GitHub <span>↗</span>
          </a>
        </div>
      </section>

      <section class="journal-section" id="journal">
        <div class="section-wrap journal-inner">
          <div class="section-kicker"><span>04</span> THE OPEN NOTEBOOK</div>
          <div class="journal-grid">
            <div>
              <h2>Ideas are better<br />when <em>they travel.</em></h2>
              <p>
                A home for essays, tutorials, field notes, and lessons learned along the
                way. I’m putting the first entries together now.
              </p>
            </div>
            <div class="journal-card">
              <span class="journal-icon" aria-hidden="true">✳</span>
              <span class="journal-label">THE JOURNAL</span>
              <h3>Stories and notes,<br />coming into focus.</h3>
              <span class="journal-status"><span class="status-dot"></span> A new chapter is in the works</span>
            </div>
          </div>
        </div>
      </section>

      <section class="social-section section-wrap" id="contact">
        <div class="section-kicker"><span>05</span> KEEP IN TOUCH</div>
        <div class="social-heading">
          <h2>Come along<br />for the <em>journey.</em></h2>
          <p>
            I share the things I’m learning and the moments I’m seeing. Follow along,
            say hello, or find something that sparks an idea.
          </p>
        </div>
        <div class="social-list">
          {socialLinks.map((social) => (
            <a class="social-row" href={social.href} target="_blank" rel="noreferrer">
              <span class="social-icon" aria-hidden="true">{social.icon}</span>
              <span class="social-name">{social.label}</span>
              <span class="social-detail">{social.detail}</span>
              <span class="social-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <p class="social-note">More places to connect are on the way.</p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-top section-wrap">
        <a class="wordmark" href="#home" aria-label="Alfan Azizi, back to top">
          <span class="wordmark-icon">A<span>.</span></span>
          <span class="wordmark-name">Alfan Azizi</span>
        </a>
        <p>“Every street tells a story.<br />Every technology shapes a future.”</p>
        <a class="back-top" href="#home">BACK TO TOP <span>↑</span></a>
      </div>
      <div class="footer-bottom section-wrap">
        <span>© <span id="current-year">2026</span> Alfan Azizi · MADE WITH CURIOSITY</span>
        <span>BUILT FOR THE OPEN WEB <span class="accent">✳</span></span>
      </div>
    </footer>
    <script is:inline src="/script.js" defer></script>
  </body>
</html>
